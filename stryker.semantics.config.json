{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx vitest run --config vitest.reverse-tools-semantics.config.ts"
  },
  "plugins": ["@stryker-mutator/typescript-checker"],
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.reverse-tools-mutation.json",
  "typescriptChecker": {
    "prioritizePerformanceOverAccuracy": true
  },
  "coverageAnalysis": "off",
  "mutate": [
    "src/cutter/CutterBridgeClient.ts:337-337",
    "src/cutter/CutterBridgeClient.ts:341-341",
    "src/cutter/CutterBridgeClient.ts:349-349",
    "src/cutter/CutterBridgeClient.ts:382-382",
    "src/rizin/RizinDebugSessionManager.ts:40-72"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "concurrency": 2,
  "timeoutMS": 30000,
  "reporters": ["clear-text", "progress", "html", "json"]
}
